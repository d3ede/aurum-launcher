{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurum Launcher",
  "version": "0.3.9",
  "identifier": "app.auren.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "powershell -NoProfile -File scripts/installer-assets.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurum Launcher",
        "center": true,
        "visible": false,
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "installerHooks": "installer/aurum-ui.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["English", "Russian", "Ukrainian", "Spanish", "German", "French", "Polish"],
        "displayLanguageSelector": false,
        "customLanguageFiles": {"Polish": "installer/Polish.nsh"}
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGM0YwODAzMkNDRTE5NTcKUldSWEdjNHNBd2cvSDV5aklMVnNoL1RTME5sckxsU3NFeUQ1NkNHS1ZFSVFDeUpqdlBZaVplWkYK",
      "endpoints": [
        "https://github.com/d3ede/aurum-launcher/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
