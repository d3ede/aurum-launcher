{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurum Launcher",
  "version": "0.6.7",
  "identifier": "app.auren.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "powershell -NoProfile -File scripts/build-desktop-assets.ps1",
    "beforeBundleCommand": "powershell -NoProfile -File scripts/installer-assets.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Aurum Launcher",
        "center": true,
        "visible": false,
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Aurum",
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "installerHooks": "installer/aurum-ui.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": [
          "English",
          "Russian",
          "Ukrainian",
          "Spanish",
          "German",
          "French",
          "Polish"
        ],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Polish": "installer/Polish.nsh"
        }
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../src/assets/loaders/HORIZON-LICENSE": "licenses/Horizon-MIT.txt",
      "../src/assets/loaders/NEOFORGE-LICENSE": "licenses/NeoForge-CC-BY-4.txt",
      "../src/assets/loaders/QUILT-LICENSE": "licenses/Quilt-CC0.txt",
      "../src/assets/loaders/README.md": "licenses/loader-marks.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGM0YwODAzMkNDRTE5NTcKUldSWEdjNHNBd2cvSDV5aklMVnNoL1RTME5sckxsU3NFeUQ1NkNHS1ZFSVFDeUpqdlBZaVplWkYK",
      "endpoints": [
        "https://github.com/d3ede/aurum-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
